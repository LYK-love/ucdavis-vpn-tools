#!/bin/zsh
set -euo pipefail

CONFIG_FILE="/Library/Application Support/ucdavis-vpn-daemon/config.env"
COMMAND="status"
PROGRAM_NAME="${0:t}"
WAIT_FOR_CONNECT="${UCDAVIS_VPNCTL_WAIT:-0}"

while (( $# > 0 )); do
  case "$1" in
    --config)
      CONFIG_FILE="$2"
      shift 2
      ;;
    --wait)
      WAIT_FOR_CONNECT=1
      shift
      ;;
    -h|--help|help)
      COMMAND="help"
      shift
      ;;
    *)
      COMMAND="$1"
      shift
      break
      ;;
  esac
done

[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

STATE_DIR="${STATE_DIR:-/var/run/ucdavis-openconnect-daemon}"
CONTROL_DIR="${CONTROL_DIR:-$STATE_DIR/control}"
CONTROL_RESPONSE_DIR="${CONTROL_RESPONSE_DIR:-$STATE_DIR/control/responses}"
LABEL="${LABEL:-local.ucdavis-openconnect-daemon}"
PLIST_FILE="${PLIST_FILE:-/Library/LaunchDaemons/$LABEL.plist}"
ROOT_DAEMON_BIN="${ROOT_DAEMON_BIN:-/usr/local/sbin/ucdavis-vpn-root-daemon}"
if [[ ! -x "$ROOT_DAEMON_BIN" && -x "${0:A:h}/ucdavis-vpn-root-daemon" ]]; then
  ROOT_DAEMON_BIN="${0:A:h}/ucdavis-vpn-root-daemon"
fi

usage() {
  cat <<EOF
Usage: $PROGRAM_NAME [--config path] [--wait] <command>

No-sudo commands:
  status       Print VPN status.
  doctor       Print dependency and config checks.
  set-password Prompt for the VPN password and store it in macOS Keychain.
  connect      Clear retry block and start connecting in the background.
  disconnect   Disconnect the tunnel, leaving auto reconnect enabled.
  logout       Log out the tunnel session, leaving auto reconnect enabled.
  pause        Pause automatic reconnect.
  resume       Resume automatic reconnect.
  off|disable  Pause automatic reconnect and log out the tunnel.
  on|enable    Resume automatic reconnect and start connecting in the background.
  reset-login  Reset the dedicated Chrome login profile.
  once         Ask the daemon to run one monitor pass.

Config:
  $CONFIG_FILE

Troubleshooting:
  $PROGRAM_NAME status
  $PROGRAM_NAME doctor
  tail -n 80 /var/log/ucdavis-openconnect-daemon/daemon.log
EOF
}

print_launchdaemon_help() {
  cat >&2 <<EOF

LaunchDaemon checks:
  launchctl print system/$LABEL

If launchctl says the service is already loaded, do not bootstrap it again.
Restart it with:
  sudo launchctl bootout system "$PLIST_FILE"
  sudo launchctl bootstrap system "$PLIST_FILE"

If it is not loaded yet:
  sudo launchctl bootstrap system "$PLIST_FILE"

Recent logs:
  tail -n 80 /var/log/ucdavis-openconnect-daemon/daemon.log
  tail -n 80 /var/log/ucdavis-openconnect-daemon/launchd.err.log
EOF
}

launchdaemon_loaded() {
  /bin/launchctl print "system/$LABEL" >/dev/null 2>&1
}

control_channel_available() {
  launchdaemon_loaded && [[ -d "$CONTROL_DIR" && -w "$CONTROL_DIR" ]]
}

wait_for_control_dir() {
  local waited=0
  while (( waited < 10 )); do
    control_channel_available && return 0
    sleep 1
    waited=$(( waited + 1 ))
  done
  return 1
}

start_root_daemon() {
  require_root_daemon_bin || return 1
  if ! launchdaemon_loaded; then
    print "LaunchDaemon: starting"
    /usr/bin/sudo /bin/launchctl bootstrap system "$PLIST_FILE" 2>/dev/null || true
  fi
  if ! launchdaemon_loaded; then
    print -u2 "LaunchDaemon is not loaded after bootstrap."
    print_launchdaemon_help
    return 1
  fi
  /usr/bin/sudo /bin/launchctl kickstart -k "system/$LABEL"
  wait_for_control_dir || {
    print -u2 "VPN daemon did not open its control socket in time."
    print_launchdaemon_help
    return 1
  }
}

stop_root_daemon() {
  if launchdaemon_loaded; then
    /usr/bin/sudo /bin/launchctl bootout system "$PLIST_FILE" >/dev/null 2>&1 || true
    print "LaunchDaemon: stopped"
  fi
}

require_root_daemon_bin() {
  if [[ -x "$ROOT_DAEMON_BIN" ]]; then
    return 0
  fi

  cat >&2 <<EOF
Root daemon binary is missing or not executable:
  $ROOT_DAEMON_BIN

Install or repair the LaunchDaemon:
  cd ucdavis-vpn-launchdaemon
  sudo ./install.sh
EOF
  return 1
}

command_set_password() {
  if [[ -z "${UC_DAVIS_EMAIL:-}" || "${UC_DAVIS_EMAIL:-}" == "your_email@ucdavis.edu" ]]; then
    print -u2 "Set UC_DAVIS_EMAIL in $CONFIG_FILE before storing a password."
    return 1
  fi

  local service="${KEYCHAIN_SERVICE:-ucdavis-openconnect-vpn}"
  local password
  print "This stores the VPN password in your macOS login Keychain."
  read -rs "password?UC Davis VPN password for $UC_DAVIS_EMAIL: "
  print
  if [[ -z "$password" ]]; then
    print -u2 "Password was empty; nothing stored."
    return 1
  fi

  /usr/bin/security add-generic-password \
    -a "$UC_DAVIS_EMAIL" \
    -s "$service" \
    -l "UC Davis VPN password" \
    -T /usr/bin/security \
    -U \
    -w "$password"
  unset password
  print "Keychain:     OK ($service / $UC_DAVIS_EMAIL)"
}

request_timeout_seconds() {
  case "$1" in
    connect|enable|on|once|reset-login) print 240 ;;
    *) print 30 ;;
  esac
}

request_waits_for_response() {
  case "$1" in
    connect|enable|on)
      [[ "$WAIT_FOR_CONNECT" == "1" ]]
      ;;
    *)
      return 0
      ;;
  esac
}

request_submitted_message() {
  case "$1" in
    connect|enable|on)
      print "VPN: connecting"
      print "Finish Chrome/Duo if prompted."
      print "Check: $PROGRAM_NAME status"
      print "Stop:  $PROGRAM_NAME off"
      ;;
    *)
      ;;
  esac
}

response_output() {
  /usr/bin/awk '
    $0 == "output<<EOF" { in_output=1; next }
    $0 == "EOF" { in_output=0; next }
    in_output { print }
  ' "$1"
}

response_exit() {
  /usr/bin/awk -F= '$1 == "exit" { print $2; exit }' "$1"
}

send_control_request() {
  local command="$1"
  local id request tmp response waited timeout code output
  control_channel_available || {
    print -u2 "VPN daemon is not accepting commands."
    if ! launchdaemon_loaded; then
      print -u2 "LaunchDaemon is not loaded; stale control files may be present."
    fi
    print -u2 "Check:"
    print -u2 "  $PROGRAM_NAME doctor"
    print -u2 "  launchctl print system/$LABEL"
    print_launchdaemon_help
    return 1
  }

  id="$(/bin/date +%s).$$.$RANDOM"
  request="$CONTROL_DIR/$id.request"
  tmp="$request.tmp"
  response="$CONTROL_RESPONSE_DIR/$id.response"
  {
    print "command=$command"
    print "created_at=$(/bin/date +%Y-%m-%dT%H:%M:%S%z)"
  } > "$tmp"
  chmod 0600 "$tmp" >/dev/null 2>&1 || true
  mv "$tmp" "$request"

  if ! request_waits_for_response "$command"; then
    request_submitted_message "$command"
    return 0
  fi

  timeout="$(request_timeout_seconds "$command")"
  waited=0
  while (( waited < timeout )); do
    if [[ -f "$response" ]]; then
      code="$(response_exit "$response")"
      output="$(response_output "$response")"
      rm -f "$response"
      [[ -n "$output" ]] && print -r -- "$output"
      return "${code:-1}"
    fi
    sleep 1
    waited=$(( waited + 1 ))
  done

  print -u2 "VPN: still working after ${timeout}s"
  print -u2 "Usually this means Chrome/Duo is waiting or OpenConnect is still starting."
  print -u2 "Check:"
  print -u2 "  $PROGRAM_NAME status"
  print -u2 "  $PROGRAM_NAME reset-login"
  print -u2 "  tail -n 120 /var/log/ucdavis-openconnect-daemon/daemon.log"
  print -u2 "  tail -n 120 /var/log/ucdavis-openconnect-daemon/openconnect.log"
  return 124
}

case "$COMMAND" in
  help)
    usage
    ;;
  status)
    require_root_daemon_bin || exit 1
    if control_channel_available; then
      send_control_request status
    else
      "$ROOT_DAEMON_BIN" --config "$CONFIG_FILE" status
    fi
    ;;
  doctor)
    require_root_daemon_bin || exit 1
    "$ROOT_DAEMON_BIN" --config "$CONFIG_FILE" "$COMMAND"
    ;;
  set-password|password|store-password)
    command_set_password
    ;;
  connect|disconnect|logout|pause|resume|once|reset-login)
    send_control_request "$COMMAND"
    ;;
  off|disable)
    if control_channel_available; then
      send_control_request disable
    else
      require_root_daemon_bin || exit 1
      /usr/bin/sudo "$ROOT_DAEMON_BIN" --config "$CONFIG_FILE" disable
    fi
    stop_root_daemon
    ;;
  on|enable)
    if ! control_channel_available; then
      start_root_daemon || exit 1
    fi
    send_control_request enable
    ;;
  *)
    print -u2 "Unknown command: $COMMAND"
    print -u2 "Run '$PROGRAM_NAME help' to see valid commands."
    usage >&2
    exit 2
    ;;
esac
